       "settings": {
        "tabs": [
         {
          "_id": "420107a",
          "tab_title": "My toy arrived damaged or doesn't work",
          "tab_content": "<p>We're sorry! Contact us within 7 days of delivery with your order number and a photo or video, and we'll send a replacement or refund you in full, including delivery.</p>"
         },
         {
          "_id": "173c6ad",
          "tab_title": "Can I return a toy I don't want?",
          "tab_content": "<p>Yes, within 7 days of delivery, if it's unused and in its original packaging. Contact us first and we'll explain how to send it back. Once we receive it, we refund the price of the toy.</p>"
         },
         {
          "_id": "eb68879",
          "tab_title": "How long do refunds take?",
          "tab_content": "<p>We process refunds within 5 working days of receiving the return. Your bank may take a few more days to show the money.</p>"
         }
