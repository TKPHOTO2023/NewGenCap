          "_id": "037c458",
          "tab_title": "Where do you deliver?",
          "tab_content": "<p>Anywhere in South Africa.</p>"
         },
         {
          "_id": "c8a657b",
          "tab_title": "How much does delivery cost?",
          "tab_content": "<p>The delivery fee is shown at checkout before you pay. Look out for free-delivery offers.</p>"
         },
         {
          "_id": "538124d",
          "tab_title": "How long will it take?",
          "tab_content": "<p>Orders placed before 12:00 on a weekday are packed the same day. Most orders arrive within 2 to 4 working days in the main centres, and a little longer in outlying areas.</p>"
         },
         {
          "_id": "b3aae31",
          "tab_title": "Can I track my parcel?",
          "tab_content": "<p>Yes. We email your tracking number as soon as your order ships.</p>"
         }
